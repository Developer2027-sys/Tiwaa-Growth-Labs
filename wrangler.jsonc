{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiwaa-growth-labs",

  // Rust Worker (worker/src/lib.rs) compiled to WebAssembly by worker-build.
  "main": "worker/build/index.js",
  "compatibility_date": "2025-09-01",

  // Runs before every `wrangler deploy` / `wrangler dev`:
  //   1. render templates/ + content/ into public/   (Rust: crates/site)
  //   2. compile the Worker to wasm                   (worker-build, run inside worker/)
  "build": {
    "command": "sh scripts/build.sh",
    "watch_dir": ["worker/src", "crates", "templates", "content", "assets", "scripts"]
  },

  // Static site built by `npm run build`
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",   // /services.html is served at /services
    "not_found_handling": "404-page",         // unknown URLs get public/404.html
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare D1 database for leads.
  // 1) npx wrangler d1 create tiwaa-leads
  // 2) paste the database_id it prints below
  // 3) npm run db:migrate
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiwaa-leads",
      "database_id": "743f210a-6558-48e4-bf6a-e34233896938",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }

  // To connect your domain later, add for example:
  // "routes": [{ "pattern": "www.tiwaagrowthlab.com", "custom_domain": true }]
}
